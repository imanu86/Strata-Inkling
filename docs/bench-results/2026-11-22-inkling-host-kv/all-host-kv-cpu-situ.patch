diff --git a/engine/src/inkling2/host_kv_ring.cuh b/engine/src/inkling2/host_kv_ring.cuh
new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/host_kv_ring.cuh
@@ -0,0 +1,180 @@
+#pragma once
+
+struct HostKvViews {
+    int8_t* k=nullptr;
+    int8_t* v=nullptr;
+    __half* ks=nullptr;
+    __half* vs=nullptr;
+};
+
+static HostKvViews host_kv_views(void* base,int cap,int dim,int heads) {
+    auto* k=(int8_t*)base;
+    auto* v=k+(size_t)cap*dim;
+    auto* ks=(__half*)(v+(size_t)cap*dim);
+    return {k,v,ks,ks+(size_t)cap*heads};
+}
+
+// All reads in the fast path remain in VRAM. Write-through keeps the mapped
+// pinned copy authoritative, including when an older prefix is reused.
+__global__ void host_kv_mirror(HostKvViews ring,HostKvViews absolute,const int32_t* pos,
+                               int cap,int dim,int heads) {
+    const int p=pos[0]+blockIdx.y,slot=p%cap;
+    const int i=blockIdx.x*blockDim.x+threadIdx.x;
+    if(i<dim/4) {
+        ((int*)absolute.k)[(size_t)p*(dim/4)+i]=((const int*)ring.k)[(size_t)slot*(dim/4)+i];
+        ((int*)absolute.v)[(size_t)p*(dim/4)+i]=((const int*)ring.v)[(size_t)slot*(dim/4)+i];
+    }
+    if(i<heads) {
+        absolute.ks[(size_t)p*heads+i]=ring.ks[(size_t)slot*heads+i];
+        absolute.vs[(size_t)p*heads+i]=ring.vs[(size_t)slot*heads+i];
+    }
+}
+
+// A single shared device window serves all SWA layers. The producer has already
+// written its quantized keys, values and scales to the mapped host ring on this
+// stream. Copy only the union of causal windows, preserving its physical slots.
+__global__ void host_kv_stage_swa(HostKvViews dst, HostKvViews src, const int32_t* pos,
+                                  int cap, int window, int dim, int heads) {
+    const int absolute = pos[0] - window + 1 + (int)blockIdx.x;
+    if (absolute < 0) return;
+    const int slot = absolute % cap;
+    const size_t word0 = (size_t)slot * (dim / sizeof(int));
+    for (int i = threadIdx.x; i < dim / (int)sizeof(int); i += blockDim.x) {
+        ((int*)dst.k)[word0 + i] = ((const int*)src.k)[word0 + i];
+        ((int*)dst.v)[word0 + i] = ((const int*)src.v)[word0 + i];
+    }
+    for (int h = threadIdx.x; h < heads; h += blockDim.x) {
+        const size_t i = (size_t)slot * heads + h;
+        dst.ks[i] = src.ks[i];
+        dst.vs[i] = src.vs[i];
+    }
+}
+
+static void host_kv_copy(HostKvViews dst,int dst_pos,HostKvViews src,int src_pos,
+                         int rows,int dim,int heads,cudaMemcpyKind kind,cudaStream_t stream) {
+    if(rows<=0)return;
+    CK(cudaMemcpyAsync(dst.k+(size_t)dst_pos*dim,src.k+(size_t)src_pos*dim,(size_t)rows*dim,kind,stream));
+    CK(cudaMemcpyAsync(dst.v+(size_t)dst_pos*dim,src.v+(size_t)src_pos*dim,(size_t)rows*dim,kind,stream));
+    CK(cudaMemcpyAsync(dst.ks+(size_t)dst_pos*heads,src.ks+(size_t)src_pos*heads,(size_t)rows*heads*sizeof(__half),kind,stream));
+    CK(cudaMemcpyAsync(dst.vs+(size_t)dst_pos*heads,src.vs+(size_t)src_pos*heads,(size_t)rows*heads*sizeof(__half),kind,stream));
+}
+
+#include "host_kv_tile.cuh"
+
+struct HostKvRing {
+    bool tiled=false;
+    bool all_swa=false, direct_swa=false;
+    int swa_layers=0;
+    size_t swa_host_bytes=0, swa_device_bytes=0;
+    void* swa_storage=nullptr;
+    HostKvViews swa_workspace{};
+    float* states=nullptr;
+    size_t state_bytes=0;
+    void allocate_states(int tmax,int splits,int query_heads) {
+        if(!tiled)return;
+        state_bytes=(size_t)std::max(tmax,splits)*query_heads*4*130*sizeof(float);
+        CK(cudaMalloc(&states,state_bytes));
+    }
+    int ring=0,stage=0,dim=0,heads=0,full_layers=0,last_tier=-1;
+    uint64_t forward_counts[3]{},mirror_bytes=0,prefix_h2d=0;
+    size_t host_bytes=0;
+    std::vector<void*> pages;
+    std::vector<HostKvViews> host,mapped;
+    void* staging=nullptr;
+    HostKvViews workspace{};
+    size_t row_bytes() const {return (size_t)2*dim+2*heads*sizeof(__half);}
+    bool init(int layers,int context,int dimension,int kv_heads,int device,std::string& err) {
+        if(!ring)return true;
+        dim=dimension;heads=kv_heads;
+        int supported=0;CK(cudaDeviceGetAttribute(&supported,cudaDevAttrCanMapHostMemory,device));
+        if(!supported){err="host KV requires mapped pinned host memory";return false;}
+        pages.resize(layers,nullptr);host.resize(layers);mapped.resize(layers);
+        if(stage>0) {
+            auto rc=cudaMalloc(&staging,(size_t)stage*row_bytes());
+            if(rc!=cudaSuccess){err=std::string("host KV device staging: ")+cudaGetErrorString(rc);return false;}
+            workspace=host_kv_views(staging,stage,dim,heads);
+        }
+        return true;
+    }
+    bool add_layer(int layer,int context,std::string& err,bool swa=false) {
+        const size_t bytes=(size_t)context*row_bytes();
+        auto rc=cudaHostAlloc(&pages[layer],bytes,cudaHostAllocMapped);
+        if(rc!=cudaSuccess){err=std::string("host KV pinned allocation: ")+cudaGetErrorString(rc);return false;}
+        void* mapped_base=nullptr;
+        rc=cudaHostGetDevicePointer(&mapped_base,pages[layer],0);
+        if(rc!=cudaSuccess){err=std::string("host KV mapping: ")+cudaGetErrorString(rc);return false;}
+        host[layer]=host_kv_views(pages[layer],context,dim,heads);
+        mapped[layer]=host_kv_views(mapped_base,context,dim,heads);
+        if (swa) {
+            ++swa_layers;
+            swa_host_bytes += bytes;
+            std::memset(pages[layer], 0, bytes);
+            if (!direct_swa && !swa_storage) {
+                rc = cudaMalloc(&swa_storage, bytes);
+                if (rc != cudaSuccess) {
+                    err = std::string("host SWA device window: ") + cudaGetErrorString(rc);
+                    return false;
+                }
+                swa_device_bytes = bytes;
+                swa_workspace = host_kv_views(swa_storage,context,dim,heads);
+            }
+        } else {
+            host_bytes += bytes;
+            ++full_layers;
+        }
+        return true;
+    }
+    ~HostKvRing(){
+        if(swa_storage)cudaFree(swa_storage);
+        if(states)cudaFree(states);
+        if(staging)cudaFree(staging);
+        for(void* page:pages)if(page)cudaFreeHost(page);
+    }
+    void record(int pos,int rows) {
+        const int end=pos+rows,tier=end<=ring?0:(end<=stage?1:2);
+        ++forward_counts[tier];
+        mirror_bytes+=(uint64_t)rows*row_bytes()*full_layers;
+        if(tier==1 || (tier==2 && tiled))prefix_h2d+=(uint64_t)(end-ring)*row_bytes()*full_layers;
+        if(tier!=last_tier){
+            std::fprintf(stderr,"HOSTKV tier=%s pos=%d T=%d visible=%d ring=%d stage=%d\n",
+                         tier==0?"device-ring":tier==1?"dma-stage":tiled?"dma-tiles":"mapped-host",pos,rows,end,ring,stage);
+            last_tier=tier;
+        }
+    }
+    HostKvViews read(int layer,HostKvViews device_ring,int end,cudaStream_t stream) {
+        if(end<=ring)return device_ring;
+        if(end>stage)return mapped[layer];
+        const int cold=end-ring;
+        host_kv_copy(workspace,0,host[layer],0,cold,dim,heads,cudaMemcpyHostToDevice,stream);
+        const int slot=cold%ring,first=ring-slot;
+        host_kv_copy(workspace,cold,device_ring,slot,first,dim,heads,cudaMemcpyDeviceToDevice,stream);
+        host_kv_copy(workspace,cold+first,device_ring,0,ring-first,dim,heads,cudaMemcpyDeviceToDevice,stream);
+        return workspace;
+    }
+    void attend_tiles(int layer,HostKvViews device_ring,const float* q,const float* rel,const float* sink,
+                      const float* gate,float* out,float* split_out,int pos,int rows,int H,int extent,
+                      int native_splits,float scale,cudaStream_t stream) {
+        const int end=pos+rows,cold=end-ring,splits=rows==1?native_splits:1;
+        const dim3 grid(H,splits,rows);
+        for(int first=0;first<cold;first+=stage){
+            const int n=std::min(stage,cold-first);
+            host_kv_copy(workspace,0,host[layer],first,n,dim,heads,cudaMemcpyHostToDevice,stream);
+            host_kv_tile_step<<<grid,128,0,stream>>>(q,workspace,rel,sink,states,H,heads,extent,
+                                                    pos,first,first+n,0,splits,scale);
+        }
+        host_kv_tile_step<<<grid,128,0,stream>>>(q,device_ring,rel,sink,states,H,heads,extent,
+                                                pos,cold,end,ring,splits,scale);
+        host_kv_tile_finish<<<grid,128,0,stream>>>(states,gate,out,split_out,H,splits,rows==1);
+        if(rows==1)k_attn_split_combine<<<H,128,0,stream>>>(split_out,gate,out,H,splits);
+    }
+    void restore(int layer,HostKvViews device_ring,int end,cudaStream_t stream) {
+        const int begin=std::max(0,end-ring),slot=begin%ring,rows=end-begin,first=std::min(rows,ring-slot);
+        host_kv_copy(device_ring,slot,host[layer],begin,first,dim,heads,cudaMemcpyHostToDevice,stream);
+        host_kv_copy(device_ring,0,host[layer],begin+first,rows-first,dim,heads,cudaMemcpyHostToDevice,stream);
+    }
+    void stats(const char* where) const {
+        if(ring)std::fprintf(stderr,"HOSTKV %s device_fwds=%llu stage_fwds=%llu overflow_fwds=%llu mirror_bytes=%llu cold_dma_h2d_bytes=%llu\n",
+            where,(unsigned long long)forward_counts[0],(unsigned long long)forward_counts[1],
+            (unsigned long long)forward_counts[2],(unsigned long long)mirror_bytes,(unsigned long long)prefix_h2d);
+    }
+};
diff --git a/engine/src/inkling2/host_kv_tile.cuh b/engine/src/inkling2/host_kv_tile.cuh
new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/host_kv_tile.cuh
@@ -0,0 +1,80 @@
+#pragma once
+
+// A tile boundary checkpoints each original warp's FP32 recurrence. It does
+// not introduce a softmax partition or change the sequence of that warp.
+__global__ void host_kv_tile_step(const float* q,HostKvViews kv,const float* rel,const float* sink,
+                                  float* states,int H,int HK,int extent,int pos,int first,int end,
+                                  int ring_cap,int splits,float scale) {
+    const int h=blockIdx.x,sp=blockIdx.y,t=blockIdx.z;
+    const int warp=threadIdx.x/32,lane=threadIdx.x%32,hkv=h/3;
+    const int row=t*H+h,qpos=pos+t;
+    const float4 query=((const float4*)(q+(size_t)row*128))[lane];
+    float* state=states+(((size_t)row*splits+sp)*4+warp)*130;
+    const bool has_sink=sp==0 && warp==0;
+    float maximum=first?state[128]:(has_sink?0.f:-1e30f);
+    float weight=first?state[129]:(has_sink?1.f:0.f);
+    float acc[4]={};
+    if(first){
+        #pragma unroll
+        for(int d=0;d<4;++d)acc[d]=state[4*lane+d];
+    }
+    const int stride=4*splits,base=sp*4+warp;
+    int j=base;
+    if(j<first)j+=((first-j+stride-1)/stride)*stride;
+    for(;j<min(end,qpos+1);j+=stride){
+        const int slot=ring_cap ? j%ring_cap : j-first;
+        const size_t key=(size_t)slot*HK+hkv;
+        const char4 k=((const char4*)(kv.k+key*128))[lane];
+        const char4 v=((const char4*)(kv.v+key*128))[lane];
+        // Both native kernels compile the y product first on SM86.
+        float dot=__fmaf_rn(query.x,(float)k.x,__fmul_rn(query.y,(float)k.y));
+        dot=__fmaf_rn(query.z,(float)k.z,dot);
+        dot=__fmaf_rn(query.w,(float)k.w,dot);
+        #pragma unroll
+        for(int off=16;off;off>>=1)dot+=__shfl_xor_sync(~0u,dot,off);
+        const int dist=qpos-j;
+        const float bias=dist<extent ? rel[(size_t)row*extent+dist] : -sink[row];
+        const float score=__fmaf_rn(dot,__fmul_rn(__half2float(kv.ks[key]),scale),bias);
+        const float next=fmaxf(maximum,score);
+        const float alpha=weight>0?__expf(maximum-next):0.f;
+        const float p=__expf(score-next),pv=__fmul_rn(p,__half2float(kv.vs[key]));
+        weight=__fmaf_rn(weight,alpha,p);
+        acc[0]=__fmaf_rn(pv,(float)v.x,__fmul_rn(acc[0],alpha));
+        acc[1]=__fmaf_rn(pv,(float)v.y,__fmul_rn(acc[1],alpha));
+        acc[2]=__fmaf_rn(pv,(float)v.z,__fmul_rn(acc[2],alpha));
+        acc[3]=__fmaf_rn(pv,(float)v.w,__fmul_rn(acc[3],alpha));
+        maximum=next;
+    }
+    #pragma unroll
+    for(int d=0;d<4;++d)state[4*lane+d]=acc[d];
+    if(!lane){state[128]=maximum;state[129]=weight;}
+}
+
+__global__ void host_kv_tile_finish(const float* states,const float* gate,float* out,
+                                    float* split_out,int H,int splits,bool decode){
+    const int h=blockIdx.x,sp=blockIdx.y,t=blockIdx.z,d=threadIdx.x;
+    const float* base=states+(((size_t)t*H+h)*splits+sp)*4*130;
+    float maximum=-1e30f;
+    #pragma unroll
+    for(int w=0;w<4;++w){
+        const float* s=base+130*w;
+        if(s[129]>0.f && s[128]>maximum)maximum=s[128];
+    }
+    float l=0.f,o=0.f;
+    #pragma unroll
+    for(int w=0;w<4;++w){
+        const float* s=base+130*w;
+        if(s[129]>0.f){
+            const float c=__expf(s[128]-maximum);
+            l=__fmaf_rn(s[129],c,l);o=__fmaf_rn(s[d],c,o);
+        }
+    }
+    if(decode){
+        float* dst=split_out+((size_t)sp*H+h)*130;
+        dst[d]=o;
+        if(!d){dst[128]=maximum;dst[129]=l;}
+    }else{
+        const size_t i=((size_t)t*H+h)*128+d;
+        float a=__fdividef(o,l);if(gate)a*=sigmf(gate[i]);out[i]=a;
+    }
+}
