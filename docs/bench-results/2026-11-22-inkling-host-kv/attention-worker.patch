new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/attention_worker.cuh
@@ -0,0 +1,23 @@
+#pragma once
+
+struct AttentionWorkerPacket {
+    const unsigned* src[7];
+    unsigned count[7], offset[7];
+};
+
+__global__ void pack_attention_worker(AttentionWorkerPacket packet, unsigned* dst) {
+    const int field = blockIdx.y;
+    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < packet.count[field]) dst[packet.offset[field] + i] = packet.src[field][i];
+}
+
+static bool attention_enable_peer(int from, int to) {
+    int accessible = 0;
+    CK(cudaDeviceCanAccessPeer(&accessible, from, to));
+    if (!accessible) return false;
+    DeviceScope on(from);
+    const auto status = cudaDeviceEnablePeerAccess(to, 0);
+    if (status == cudaSuccess) return true;
+    cudaGetLastError();
+    return status == cudaErrorPeerAccessAlreadyEnabled;
+}
