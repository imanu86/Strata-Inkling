diff --git a/engine/src/inkling2/verify_expert_pair.cuh b/engine/src/inkling2/verify_expert_pair.cuh
new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/verify_expert_pair.cuh
@@ -0,0 +1,149 @@
+#pragma once
+
+static bool verify_expert_pair_enabled() {
+    static const bool enabled=[] {
+        const char* v=std::getenv("STRATA_IK2_VERIFY_EXPERT_PAIR");
+        return v && std::strcmp(v,"1")==0;
+    }();
+    return enabled;
+}
+
+// Each expert can be selected at most once per token. Pair consecutive
+// occurrences in the five top-8 lists. The leader owns the original output
+// slots of the two entries; unpaired entries run an ordinary one-input dot.
+__device__ __forceinline__ int verify_expert_partner(const int* ids,int entry) {
+    const int lane=threadIdx.x&31, expert=ids[entry];
+    const unsigned low=__ballot_sync(~0u,ids[lane]==expert);
+    const unsigned high=__ballot_sync(~0u,lane<8 && ids[32+lane]==expert);
+    const unsigned long long mask=((unsigned long long)high<<32)|low;
+    const unsigned long long bit=1ull<<entry;
+    if(__popcll(mask&(bit-1))&1)return -2;
+    const unsigned long long following=mask&~(bit|(bit-1));
+    return __ffsll(following)-1;
+}
+
+template<bool Pair>
+__device__ __forceinline__ float2 verify_weight_dot(
+    const unsigned* row,int k,const AstraQ& a,const AstraQ* b) {
+    const unsigned* block=row+(k/2)*9;
+    const unsigned scales=block[0]>>(16*(k&1));
+    const unsigned* qs=block+1+4*(k&1);
+    float2 sum=make_float2(0.f,0.f);
+    #pragma unroll
+    for(int h=0;h<2;++h) {
+        const unsigned lo=qs[h*2],hi=qs[h*2+1];
+        const int w0=astra_decode_four(lo),w1=astra_decode_four(lo>>16);
+        const int w2=astra_decode_four(hi),w3=astra_decode_four(hi>>16);
+        const float scale=astra_scale((scales>>(8*h))&255);
+        const int j=4*h;
+        int va=__dp4a(w0,(int)a.word[j],0);
+        va=__dp4a(w1,(int)a.word[j+1],va);
+        va=__dp4a(w2,(int)a.word[j+2],va);
+        va=__dp4a(w3,(int)a.word[j+3],va);
+        sum.x+=(scale*a.scale)*(float)va;
+        if constexpr(Pair){
+            int vb=__dp4a(w0,(int)b->word[j],0);
+            vb=__dp4a(w1,(int)b->word[j+1],vb);
+            vb=__dp4a(w2,(int)b->word[j+2],vb);
+            vb=__dp4a(w3,(int)b->word[j+3],vb);
+            sum.y+=(scale*b->scale)*(float)vb;
+        }
+    }
+    return sum;
+}
+
+template<bool Pair>
+__device__ __forceinline__ void verify_gu_pair_body(const uint8_t* blob,K::NativeExpertLayout L,
+    const AstraQ* input,AstraQ* hidden,int entry,int partner) {
+    const int lane=threadIdx.x&31,warp=threadIdx.x/32,first=blockIdx.x*32;
+    __shared__ AstraQ x[Pair?2:1][72];
+    __shared__ float2 products[Pair?2:1][32];
+    const float* scale=(const float*)(blob+L.tail_off);
+    #pragma unroll
+    for(int t=0;t<(Pair?2:1);++t){
+        const AstraQ* token=input+(t==0?entry:partner)/8*72;
+        for(int k=warp;k<72;k+=8){
+            if(lane<8)x[t][k].word[lane]=token[k].word[lane];
+            if(lane==8)x[t][k].scale=token[k].scale;
+        }
+    }
+    __syncthreads();
+    #pragma unroll 1
+    for(int sub=warp;sub<32;sub+=8){
+        const unsigned* g=(const unsigned*)(blob+(first+sub)*L.gu_row);
+        const unsigned* u=(const unsigned*)(blob+L.up_off+(first+sub)*L.gu_row);
+        float vg[2]={},vu[2]={};
+        #pragma unroll
+        for(int start=0;start<72;start+=32){
+            const int k=start+lane;
+            if(k<72){
+                const AstraQ* buddy=Pair?&x[Pair?1:0][k]:nullptr;
+                const float2 gate=verify_weight_dot<Pair>(g,k,x[0][k],buddy);
+                const float2 up=verify_weight_dot<Pair>(u,k,x[0][k],buddy);
+                vg[0]+=gate.x;vu[0]+=up.x;
+                if constexpr(Pair){vg[1]+=gate.y;vu[1]+=up.y;}
+            }
+        }
+        #pragma unroll
+        for(int t=0;t<(Pair?2:1);++t){
+            #pragma unroll
+            for(int d=16;d;d>>=1){
+                vg[t]+=__shfl_xor_sync(~0u,vg[t],d);
+                vu[t]+=__shfl_xor_sync(~0u,vu[t],d);
+            }
+            if(!lane)products[t][sub]=make_float2(vg[t]*scale[0],vu[t]*scale[1]);
+        }
+    }
+    __syncthreads();
+    if(!warp){
+        #pragma unroll
+        for(int t=0;t<(Pair?2:1);++t){
+            const float2 gu=products[t][lane];
+            const float beta=L.situ_beta,lb=L.situ_linear_beta;
+            const float gate=beta*tanhf(gu.x/beta)*(1.f/(1.f+__expf(-gu.x)));
+            const float up=lb>0.f ? lb*tanhf(gu.y/lb) : gu.y;
+            astra_store_q(gate*up,hidden,(t==0?entry:partner)*1152+first+lane);
+        }
+    }
+}
+
+__global__ void __launch_bounds__(256) verify_gu_pair(const uint8_t* blobs,size_t stride,
+    const int* slots,const int* ids,K::NativeExpertLayout L,const AstraQ* x,AstraQ* h){
+    const int e=blockIdx.y,p=verify_expert_partner(ids,e);
+    if(p==-2)return;
+    const uint8_t* blob=blobs+slots[ids[e]]*stride;
+    if(p<0)verify_gu_pair_body<false>(blob,L,x,h,e,p);
+    else verify_gu_pair_body<true>(blob,L,x,h,e,p);
+}
+
+template<bool Pair>
+__device__ __forceinline__ void verify_down_pair_body(const unsigned* row,const AstraQ* hidden,
+    float* parts,int e,int p,int r,float scale){
+    const int lane=threadIdx.x&15;
+    const AstraQ* a=hidden+e*36;
+    const AstraQ* b=Pair?hidden+p*36:nullptr;
+    float2 v=verify_weight_dot<Pair>(row,lane,a[lane],Pair?b+lane:nullptr);
+    if(lane<4){
+        float2 w=verify_weight_dot<Pair>(row,32+lane,a[32+lane],Pair?b+32+lane:nullptr);
+        v.x+=w.x;if constexpr(Pair)v.y+=w.y;
+    }
+    float2 w=verify_weight_dot<Pair>(row,16+lane,a[16+lane],Pair?b+16+lane:nullptr);
+    v.x+=w.x;if constexpr(Pair)v.y+=w.y;
+    #pragma unroll
+    for(int d=8;d;d>>=1){
+        v.x+=__shfl_xor_sync(~0u,v.x,d,16);
+        if constexpr(Pair)v.y+=__shfl_xor_sync(~0u,v.y,d,16);
+    }
+    if(!lane){parts[e*2304+r]=v.x*scale;if constexpr(Pair)parts[p*2304+r]=v.y*scale;}
+}
+__global__ void __launch_bounds__(256) verify_down_pair(const uint8_t* blobs,size_t stride,
+    const int* slots,const int* ids,K::NativeExpertLayout L,const AstraQ* h,float* parts){
+    const int e=blockIdx.y,p=verify_expert_partner(ids,e);
+    if(p==-2)return;
+    const int r=blockIdx.x*16+threadIdx.x/16;
+    const uint8_t* blob=blobs+slots[ids[e]]*stride;
+    const unsigned* row=(const unsigned*)(blob+L.down_off+r*L.d_row);
+    const float scale=((const float*)(blob+L.tail_off))[2];
+    if(p<0)verify_down_pair_body<false>(row,h,parts,e,p,r,scale);
+    else verify_down_pair_body<true>(row,h,parts,e,p,r,scale);
+}
diff --git a/engine/src/inkling2/verify_next_attention.cuh b/engine/src/inkling2/verify_next_attention.cuh
new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/verify_next_attention.cuh
@@ -0,0 +1,193 @@
+#pragma once
+
+// Each query head owns one CTA. The original four lane-strided recurrences
+// are combined in their original order. Explicit RN intrinsics reproduce
+// the reference SM75/SM86 SASS for the weighted V updates.
+__global__ void verify_q8_one_head(const float* __restrict__ Q,
+                               const int8_t* __restrict__ kq, const __half* __restrict__ ks,
+                               const int8_t* __restrict__ vq, const __half* __restrict__ vs,
+                               const float* __restrict__ rel_tab, const float* __restrict__ sink,
+                               const float* __restrict__ gate, float* __restrict__ out,
+                               int n_head, int n_head_kv, int n_ext, int cap, int is_swa, int n_swa,
+                               const int32_t* __restrict__ pos0, float kq_scale) {
+    __shared__ float sq[1][128];
+    __shared__ float s_m[1][4];
+    __shared__ float s_l[1][4];
+    __shared__ float s_acc[1][4][128];
+    const int hkv = blockIdx.x / 3, t = blockIdx.y;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int kv_dim = n_head_kv * 128;
+    const int h0 = blockIdx.x;
+    if (threadIdx.x < 128) {
+#pragma unroll
+        for (int g = 0; g < 1; ++g) {
+            sq[g][threadIdx.x] = Q[((size_t) t * n_head + (h0 + g)) * 128 + threadIdx.x];
+        }
+    }
+    __syncthreads();
+
+    const int base4 = lane * 4;
+    float q[1][4];
+#pragma unroll
+    for (int g = 0; g < 1; ++g) {
+        q[g][0] = sq[g][base4];
+        q[g][1] = sq[g][base4 + 1];
+        q[g][2] = sq[g][base4 + 2];
+        q[g][3] = sq[g][base4 + 3];
+    }
+
+    const int pos_q = pos0[0] + t;
+    const int j0 = is_swa ? max(0, pos_q - n_swa + 1) : 0;
+    const int j1 = pos_q + 1;
+    const bool pow2_cap = (cap & (cap - 1)) == 0;
+    const int cap_mask = cap - 1;
+
+    float neg_sink[1];
+    const float* rt[1];
+#pragma unroll
+    for (int g = 0; g < 1; ++g) {
+        const int h = h0 + g;
+        rt[g] = rel_tab + ((size_t) t * n_head + h) * n_ext;
+        neg_sink[g] = -sink[(size_t) t * n_head + h];
+    }
+
+    float m[1], l[1], acc[1][4];
+#pragma unroll
+    for (int g = 0; g < 1; ++g) {
+        m[g] = (warp == 0) ? 0.0f : -1e30f;
+        l[g] = (warp == 0) ? 1.0f : 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) acc[g][i] = 0.0f;
+    }
+
+    for (int j = j0 + warp; j < j1; j += 4) {
+        const int slot = is_swa ? (pow2_cap ? (j & cap_mask) : (j % cap)) : j;
+        const size_t idx = (size_t) slot * n_head_kv + hkv;
+        const float d_k = __half2float(ks[idx]);
+        const float d_v = __half2float(vs[idx]);
+        const int8_t* kj = kq + (size_t) slot * kv_dim + hkv * 128;
+        const int8_t* vj = vq + (size_t) slot * kv_dim + hkv * 128;
+        const char4 kc4 = *reinterpret_cast<const char4*>(kj + base4);
+        const float k0 = (float) kc4.x, k1 = (float) kc4.y, k2 = (float) kc4.z, k3 = (float) kc4.w;
+        const char4 vc4 = *reinterpret_cast<const char4*>(vj + base4);
+        const float v0 = (float) vc4.x, v1 = (float) vc4.y, v2 = (float) vc4.z, v3 = (float) vc4.w;
+        const int dist = pos_q - j;
+        const float dkkq = d_k * kq_scale;
+
+        float dot0 = q[0][0] * k0 + q[0][1] * k1 + q[0][2] * k2 + q[0][3] * k3;
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            dot0 += __shfl_xor_sync(0xffffffffu, dot0, o);
+        }
+        const float dots[1] = {dot0};
+#pragma unroll
+        for (int g = 0; g < 1; ++g) {
+            const float bias = dist < n_ext ? rt[g][dist] : neg_sink[g];
+            const float sc = dots[g] * dkkq + bias;
+            const float m_new = fmaxf(m[g], sc);
+            const float alpha = l[g] > 0.0f ? __expf(m[g] - m_new) : 0.0f;
+            const float p = __expf(sc - m_new);
+            const float pv = p * d_v;
+            l[g] = l[g] * alpha + p;
+            acc[g][0] = __fmaf_rn(pv, v0, __fmul_rn(acc[g][0], alpha));
+            acc[g][1] = __fmaf_rn(pv, v1, __fmul_rn(acc[g][1], alpha));
+            acc[g][2] = __fmaf_rn(pv, v2, __fmul_rn(acc[g][2], alpha));
+            acc[g][3] = __fmaf_rn(pv, v3, __fmul_rn(acc[g][3], alpha));
+            m[g] = m_new;
+        }
+    }
+
+#pragma unroll
+    for (int g = 0; g < 1; ++g) {
+        if (lane == 0) {
+            s_m[g][warp] = m[g];
+            s_l[g][warp] = l[g];
+        }
+        s_acc[g][warp][base4] = acc[g][0];
+        s_acc[g][warp][base4 + 1] = acc[g][1];
+        s_acc[g][warp][base4 + 2] = acc[g][2];
+        s_acc[g][warp][base4 + 3] = acc[g][3];
+    }
+    __syncthreads();
+    if (threadIdx.x < 128) {
+#pragma unroll
+        for (int g = 0; g < 1; ++g) {
+            float mg = s_m[g][0];
+            for (int w = 1; w < 4; ++w) if (s_l[g][w] > 0.0f && s_m[g][w] > mg) mg = s_m[g][w];
+            float lg = 0.0f, og = 0.0f;
+            for (int w = 0; w < 4; ++w) {
+                if (s_l[g][w] > 0.0f) {
+                    const float c = __expf(s_m[g][w] - mg);
+                    lg += s_l[g][w] * c;
+                    og += s_acc[g][w][threadIdx.x] * c;
+                }
+            }
+            const size_t oi = ((size_t) t * n_head + (h0 + g)) * 128 + threadIdx.x;
+            float val = __fdividef(og, lg);
+            if (gate) val *= sigmf(gate[oi]);
+            out[oi] = val;
+        }
+    }
+}
+
+// A different schedule for the same four online-softmax recurrences. The score
+// producer expands temporal parallelism without partitioning a recurrence.
+__global__ void verify_swa_scores(const float* Q,const int8_t* kq,const __half* ks,
+                                  const float* rel,const float* sink,float* scores,
+                                  int H,int HK,int extent,int cap,int window,const int* pos,float scale){
+    const int row=blockIdx.y,t=row/H,h=row%H,kv=h/3;
+    const int qpos=*pos+t,first=max(0,qpos-window+1),n=qpos-first+1;
+    const int warp=threadIdx.x/32,lane=threadIdx.x%32;
+    const float4 q=((const float4*)(Q+row*128))[lane];
+    const int end=min(n,((int)blockIdx.x+1)*64);
+    for(int j=blockIdx.x*64+warp;j<end;j+=8){
+        const int loc=first+j;
+        const int slot=(cap&(cap-1)) ? loc%cap : loc&(cap-1);
+        const size_t head=(size_t)slot*HK+kv;
+        const char4 k=((const char4*)(kq+head*128))[lane];
+        float dot=q.x*(float)k.x+q.y*(float)k.y+q.z*(float)k.z+q.w*(float)k.w;
+        #pragma unroll
+        for(int o=16;o;o>>=1)dot+=__shfl_xor_sync(0xffffffffu,dot,o);
+        if(!lane){
+            const int dist=qpos-loc;
+            const float bias=dist<extent?rel[(size_t)row*extent+dist]:-sink[row];
+            const float dkkq=__half2float(ks[head])*scale;
+            scores[(size_t)row*window+j]=dot*dkkq+bias;
+        }
+    }
+}
+
+__global__ void verify_swa_weighted(const int8_t* vq,const __half* vs,const float* scores,
+                                     float* part,int H,int HK,int window,int cap,const int* pos){
+    const int row=blockIdx.x/4, w=blockIdx.x%4,hkv=(row%H)/3;
+    const int qpos=*pos+row/H,first=max(0,qpos-window+1),n=qpos-first+1;
+    float m=w==0?0.f:-1e30f,l=w==0?1.f:0.f,acc=0.f;
+    for(int j=w;j<n;j+=4){
+        const int loc=first+j,slot=(cap&(cap-1)) ? loc%cap : loc&(cap-1);
+        const size_t head=(size_t)slot*HK+hkv;
+        const float sc=scores[(size_t)row*window+j];
+        const float next=fmaxf(m,sc);
+        const float alpha=l>0?__expf(m-next):0.f;
+        const float p=__expf(sc-next),pv=p*__half2float(vs[head]);
+        l=l*alpha+p;
+        acc=__fmaf_rn(pv,(float)vq[head*128+threadIdx.x],__fmul_rn(acc,alpha));
+        m=next;
+    }
+    float* dst=part+(size_t)blockIdx.x*130;
+    dst[threadIdx.x]=acc;if(threadIdx.x==0){dst[128]=m;dst[129]=l;}
+}
+__global__ void verify_swa_combine(const float* part,const float* gate,float* out){
+    int row=blockIdx.x,d=threadIdx.x;
+    const float* base=part+(size_t)row*4*130;
+    float m=base[128];
+    #pragma unroll
+    for(int w=1;w<4;++w){const float* p=base+w*130;if(p[129]>0 && p[128]>m)m=p[128];}
+    float l=0.f,o=0.f;
+    #pragma unroll
+    for(int w=0;w<4;++w){
+        const float* p=base+w*130;
+        if(p[129]>0){float c=__expf(p[128]-m);l+=p[129]*c;o+=p[d]*c;}
+    }
+    size_t i=(size_t)row*128+d;
+    float v=__fdividef(o,l);if(gate)v*=sigmf(gate[i]);out[i]=v;
+}
