+++ b/engine/src/inkling2/astra_control_streams.cuh
@@ -0,0 +1,64 @@
+#pragma once
+
+// The two additional lanes own all mutable storage touched by K and V.
+// The original Engine stream, handle and scratch are used for Q. Recording
+// the fork and join also makes these dependencies part of a captured graph.
+struct AstraControlLane {
+    cudaStream_t stream = nullptr;
+    cublasHandle_t blas = nullptr;
+    cudaEvent_t done = nullptr;
+    void* blas_workspace = nullptr;
+    float* scratch = nullptr;
+
+    void init(int n, int rank, int rows) {
+        constexpr size_t workspace_bytes = 4 * 1024 * 1024;
+        CK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        CK(cudaEventCreateWithFlags(&done, cudaEventDisableTiming));
+        CKB(cublasCreate(&blas));
+        CKB(cublasSetStream(blas, stream));
+        CK(cudaMalloc(&blas_workspace, workspace_bytes));
+        CKB(cublasSetWorkspace(blas, blas_workspace, workspace_bytes));
+        CK(cudaMalloc(&scratch, (size_t)rows * (4 * n + rank) * sizeof(float)));
+    }
+
+    void run(const PhysLayer& layer, int mod, const float* cur, const float* msg,
+             float* out, int t, int n, int rank, float eps) {
+        float* prep = scratch;
+        float* down = prep + (size_t)t * 2 * n;
+        float* gain = down + (size_t)t * rank;
+        float* forget = gain + (size_t)t * n;
+        k_control_prep<<<dim3(2,t),kThreads,0,stream>>>(cur,msg,prep,n,eps);
+        const float alpha = 1.0f, beta = 0.0f;
+        auto project = [&](const DenseMat& matrix, const float* x, float* y,
+                           int width, int outputs) {
+            CKB(cublasSgemm(blas, CUBLAS_OP_T, CUBLAS_OP_N, outputs, t, width,
+                &alpha, (const float*)matrix.d, width, x, width, &beta, y, outputs));
+        };
+        project(layer.loop_down[mod], prep, down, 2 * n, rank);
+        project(layer.loop_gain[mod], down, gain, rank, n);
+        project(layer.loop_forget[mod], down, forget, rank, n);
+        const int size = n * t;
+        k_control_combine<<<(size+255)/256,256,0,stream>>>(cur,msg,gain,forget,out,size);
+        CK(cudaEventRecord(done, stream));
+    }
+
+    ~AstraControlLane() {
+        if (blas) cublasDestroy(blas);
+        if (stream) cudaStreamDestroy(stream);
+        if (done) cudaEventDestroy(done);
+        cudaFree(blas_workspace);
+        cudaFree(scratch);
+    }
+};
+
+struct AstraControlStreams {
+    cudaEvent_t ready = nullptr;
+    AstraControlLane lanes[2];
+    AstraControlStreams(int n, int rank, int rows) {
+        CK(cudaEventCreateWithFlags(&ready, cudaEventDisableTiming));
+        for (auto& lane : lanes) lane.init(n, rank, rows);
+    }
+    ~AstraControlStreams() {
+        if (ready) cudaEventDestroy(ready);
+    }
+};
