+++ b/engine/src/inkling2/astra_pp_mma.cuh
@@ -0,0 +1,141 @@
+#pragma once
+
+// Eight routed entries form the N dimension of each integer Tensor Core tile.
+// The 16-value K extent is the native NVFP4 scale block. A and B have the
+// same within-block permutation, so all integer dot products are exact.
+static bool astra_pp_mma_enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("STRATA_IK2_ASTRA_PP_MMA");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+__device__ __forceinline__ void astra_pp_mma16(int (&d)[4], unsigned a0, unsigned a1, unsigned b) {
+    constexpr int zero = 0;
+#if __CUDA_ARCH__ >= 800
+    asm("mma.sync.aligned.m16n8k16.row.col.s32.s8.s8.s32 {%0,%1,%2,%3}, {%4,%5}, {%6}, {%7,%7,%7,%7};"
+        : "=r"(d[0]), "=r"(d[1]), "=r"(d[2]), "=r"(d[3])
+        : "r"(a0), "r"(a1), "r"(b), "r"(zero));
+#else
+    // The two 8-row Turing MMAs have the same accumulator ownership as Ampere.
+    asm("mma.sync.aligned.m8n8k16.row.col.s32.s8.s8.s32 {%0,%1}, {%2}, {%3}, {%4,%4};"
+        : "=r"(d[0]), "=r"(d[1]) : "r"(a0), "r"(b), "r"(zero));
+    asm("mma.sync.aligned.m8n8k16.row.col.s32.s8.s8.s32 {%0,%1}, {%2}, {%3}, {%4,%4};"
+        : "=r"(d[2]), "=r"(d[3]) : "r"(a1), "r"(b), "r"(zero));
+#endif
+}
+
+__global__ void astra_pp_input(const float* x, AstraQ* q) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    astra_store_q(x[i], q, i);
+}
+
+template<bool Down>
+__global__ void __launch_bounds__(256, 3) astra_pp_group_mma(
+    const unsigned long long* __restrict__ ptrs, const int* __restrict__ starts,
+    const int* __restrict__ groups, const int* __restrict__ tok, const int* __restrict__ dst,
+    K::NativeExpertLayout L, const AstraQ* __restrict__ input,
+    float* __restrict__ first_output, float* __restrict__ up_output) {
+    constexpr int ncols = Down ? 1152 : 2304;
+    constexpr int outcols = Down ? 2304 : 1152;
+    constexpr int kWarps = 8;
+    // Warp w owns native K lanes w, w+8, w+16 and w+24 for these 16 rows.
+    __shared__ float4 partial[kWarps][32];
+    const int group = blockIdx.y;
+    if (group >= *groups) return;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int row8 = lane >> 2, k4 = lane & 3, col = 2 * k4;
+    const bool up = !Down && blockIdx.x >= 1152 / 16;
+    const int row_base = 16 * blockIdx.x - (up ? 1152 : 0);
+    const uint8_t* blob = (const uint8_t*)ptrs[group];
+    const size_t offset = Down ? L.down_off : (up ? L.up_off : 0);
+    const size_t stride = Down ? L.d_row : L.gu_row;
+    const uint32_t* row0 = (const uint32_t*)(blob + offset + (row_base + row8) * stride);
+    const uint32_t* row1 = (const uint32_t*)(blob + offset + (row_base + row8 + 8) * stride);
+    const float tail = ((const float*)(blob + L.tail_off))[Down ? 2 : (up ? 1 : 0)];
+    float* out = up ? up_output : first_output;
+    const int end = starts[group + 1];
+    for (int base = starts[group]; base < end; base += 8) {
+        // A partial tile repeats its last input into padded columns. Only live
+        // columns are stored, and all 32 lanes participate in every warp MMA.
+        const int entry = min(base + row8, end - 1);
+        const int input_row = Down ? entry : tok[entry];
+        const AstraQ* x = input + (size_t)input_row * (ncols / 32);
+        // Recreate native row_dot_multi<40>'s 32 lane-strided sums and the
+        // exact 16,8,4,2,1 shuffle tree, including its nested pair of K16 dots.
+        // Visit the two native lane pairs in the order in which the +16
+        // butterfly consumes them. Only the current lane, its +16 partner
+        // and the previous folded pair must be live across a loop iteration.
+        float v[4] = {};
+        float low[4] = {};
+#pragma unroll 1
+        for (int visit = 0; visit < 4; ++visit) {
+            float lane_sum[4] = {};
+            const int native_lane = warp + 8 * (visit >> 1) + 16 * (visit & 1);
+#pragma unroll 1
+            for (int k = native_lane; k < ncols / 32; k += 32) {
+                const uint32_t* b0 = row0 + (k / 2) * 9;
+                const uint32_t* b1 = row1 + (k / 2) * 9;
+                const unsigned sc0 = b0[0], sc1 = b1[0];
+                const uint16_t* nib0 = (const uint16_t*)(b0 + 1);
+                const uint16_t* nib1 = (const uint16_t*)(b1 + 1);
+                const AstraQ& q = x[k];
+                const float xscale = q.scale;
+                const float sx0 = __shfl_sync(0xffffffffu, xscale, 4 * col);
+                const float sx1 = __shfl_sync(0xffffffffu, xscale, 4 * (col + 1));
+                float pair[4] = {};
+#pragma unroll
+                for (int h = 0; h < 2; ++h) {
+                    const int sub = 2 * (k & 1) + h;
+                    const unsigned a0 = astra_decode_four(nib0[4 * sub + k4]);
+                    const unsigned a1 = astra_decode_four(nib1[4 * sub + k4]);
+                    int dot[4];
+                    astra_pp_mma16(dot, a0, a1, q.word[4 * h + k4]);
+                    const float w0 = astra_scale((sc0 >> (sub * 8)) & 255);
+                    const float w1 = astra_scale((sc1 >> (sub * 8)) & 255);
+                    pair[0] = __fmaf_rn(__fmul_rn(w0, sx0), (float)dot[0], pair[0]);
+                    pair[1] = __fmaf_rn(__fmul_rn(w0, sx1), (float)dot[1], pair[1]);
+                    pair[2] = __fmaf_rn(__fmul_rn(w1, sx0), (float)dot[2], pair[2]);
+                    pair[3] = __fmaf_rn(__fmul_rn(w1, sx1), (float)dot[3], pair[3]);
+                }
+#pragma unroll
+                for (int j = 0; j < 4; ++j) lane_sum[j] = __fadd_rn(lane_sum[j], pair[j]);
+            }
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                if ((visit & 1) == 0) {
+                    low[j] = lane_sum[j];
+                } else {
+                    const float pair_sum = __fadd_rn(low[j], lane_sum[j]);
+                    v[j] = visit == 1 ? pair_sum : __fadd_rn(v[j], pair_sum);
+                }
+            }
+        }
+        partial[warp][lane] = make_float4(v[0], v[1], v[2], v[3]);
+        __syncthreads();
+        if (warp == 0) {
+            float4 folded[4];
+#pragma unroll
+            for (int w = 0; w < 4; ++w) {
+                const float4 a = partial[w][lane], b = partial[w + 4][lane];
+                folded[w] = make_float4(a.x+b.x, a.y+b.y, a.z+b.z, a.w+b.w);
+            }
+            v[0] = (folded[0].x + folded[2].x) + (folded[1].x + folded[3].x);
+            v[1] = (folded[0].y + folded[2].y) + (folded[1].y + folded[3].y);
+            v[2] = (folded[0].z + folded[2].z) + (folded[1].z + folded[3].z);
+            v[3] = (folded[0].w + folded[2].w) + (folded[1].w + folded[3].w);
+#pragma unroll
+            for (int c = 0; c < 2; ++c) {
+                const int e = base + col + c;
+                if (e < end) {
+                    const size_t pos = (size_t)(Down ? dst[e] : e) * outcols + row_base + row8;
+                    out[pos] = v[c] * tail;
+                    out[pos + 8] = v[c + 2] * tail;
+                }
+            }
+        }
+        // The next tile reuses the same partial storage.
+        if (base + 8 < end) __syncthreads();
+    }
+}
