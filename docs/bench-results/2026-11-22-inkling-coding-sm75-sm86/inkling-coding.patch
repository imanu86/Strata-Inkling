+#pragma once
+
+// One complete warp per GU row and a half warp per down row. Activations are
+// byte-interleaved once per Q8 block to match PRMT's native FP4 pair order.
+struct AstraQ {
+    float scale;
+    unsigned word[8];
+};
+static_assert(sizeof(AstraQ) == 36);
+
+__device__ __forceinline__ void astra_store_q(float value, AstraQ* out, int index) {
+    const int lane = threadIdx.x & 31;
+    float amax = fabsf(value);
+    #pragma unroll
+    for (int d = 16; d; d >>= 1)
+        amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, d));
+    const float d = K::q8_1_finite(amax / 127.0f);
+    const unsigned mybyte = (unsigned char)K::q8_1_quant(value, d, amax);
+    // word w spans two adjacent packed FP4 bytes (4 nibbles).
+    const int w = lane & 7;
+    const int first = (w >> 2) * 16 + (w & 3) * 2;
+    const unsigned q0 = __shfl_sync(0xffffffffu, mybyte, first);
+    const unsigned q1 = __shfl_sync(0xffffffffu, mybyte, first + 8);
+    const unsigned q2 = __shfl_sync(0xffffffffu, mybyte, first + 1);
+    const unsigned q3 = __shfl_sync(0xffffffffu, mybyte, first + 9);
+    AstraQ& b = out[index >> 5];
+    if (lane < 8) b.word[lane] = q0 | (q1 << 8) | (q2 << 16) | (q3 << 24);
+    if (lane == 0) b.scale = __half2float(__float2half(d));
+}
+
+__global__ void astra_input(const float* x, AstraQ* out) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < 2304) astra_store_q(x[i], out, i);
+}
+
+__device__ __forceinline__ unsigned astra_decode_four(unsigned nibbles) {
+    constexpr unsigned pos0 = 0x03020100u, pos1 = 0x0c080604u;
+    constexpr unsigned neg0 = 0xfdfeff00u, neg1 = 0xf4f8fafcu;
+    const unsigned pos = __byte_perm(pos0, pos1, nibbles);
+    const unsigned neg = __byte_perm(neg0, neg1, nibbles);
+    return __byte_perm(pos, neg, 0x3210u | ((nibbles & 0x8888u) >> 1));
+}
+
+__device__ __forceinline__ float astra_scale(unsigned x) {
+    const unsigned exp = (x >> 3) & 15, mantissa = x & 7;
+    if (x == 127) return 0;
+    return exp ? __uint_as_float(((119+exp) << 23) | (mantissa << 20))
+               : (float)mantissa * 0.0009765625f;
+}
+
+// NVFP4 stores four scale bytes followed by four 16-value blocks.
+__device__ __forceinline__ float astra_dot32(const unsigned* row, int k, const AstraQ& x) {
+    const unsigned* block = row + (k >> 1) * 9;
+    const unsigned scales = block[0] >> (16 * (k & 1));
+    const unsigned* qs = block + 1 + 4 * (k & 1);
+    float sum = 0;
+    #pragma unroll
+    for (int h=0; h<2; ++h) {
+        const unsigned q0 = qs[2*h], q1 = qs[2*h+1];
+        int v = __dp4a((int)astra_decode_four(q0), (int)x.word[4*h], 0);
+        v = __dp4a((int)astra_decode_four(q0>>16), (int)x.word[4*h+1], v);
+        v = __dp4a((int)astra_decode_four(q1), (int)x.word[4*h+2], v);
+        v = __dp4a((int)astra_decode_four(q1>>16), (int)x.word[4*h+3], v);
+        sum += (astra_scale((scales >> (8*h)) & 255) * x.scale) * (float)v;
+    }
+    return sum;
+}
+
+__global__ void astra_gate_up(const uint8_t* blobs, size_t stride, const int* slots, const int* ids,
+                               K::NativeExpertLayout L, const AstraQ* x, float* gate, float* up) {
+    const int row = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5);
+    const int lane = threadIdx.x & 31, top = blockIdx.y;
+    const uint8_t* blob = blobs + stride * slots[ids[top]];
+    const unsigned* g = (const unsigned*)(blob + row*L.gu_row);
+    const unsigned* u = (const unsigned*)(blob + L.up_off + row*L.gu_row);
+    float vg = 0, vu = 0;
+    #pragma unroll
+    for (int base=0; base<72; base+=32) {
+        const int k=base+lane;
+        if (k < 72) {
+            const AstraQ a = x[k];
+            vg += astra_dot32(g, k, a);
+            vu += astra_dot32(u, k, a);
+        }
+    }
+    #pragma unroll
+    for (int d=16; d; d>>=1) {
+        vg += __shfl_xor_sync(0xffffffffu,vg,d);
+        vu += __shfl_xor_sync(0xffffffffu,vu,d);
+    }
+    if (lane==0) {
+        const float* s = (const float*)(blob + L.tail_off);
+        gate[top*1152+row] = vg*s[0];
+        up[top*1152+row] = vu*s[1];
+    }
+}
+
+__global__ void astra_situ(const float* gate, const float* up, AstraQ* hq, float beta, float lb) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    const float g = gate[i], u = up[i];
+    const float tg = beta * tanhf(g / beta) * (1.0f / (1.0f + __expf(-g)));
+    const float tu = lb > 0.0f ? lb * tanhf(u / lb) : u;
+    astra_store_q(tg * tu, hq, i);
+}
+
+__global__ void astra_down(const uint8_t* blobs, size_t stride, const int* slots, const int* ids,
+                           K::NativeExpertLayout L, const AstraQ* hq, float* parts) {
+    const int row = blockIdx.x * (blockDim.x >> 4) + (threadIdx.x >> 4);
+    const int lane = threadIdx.x & 15, top = blockIdx.y;
+    const uint8_t* blob = blobs + stride * slots[ids[top]];
+    const unsigned* r = (const unsigned*)(blob + L.down_off + row*L.d_row);
+    const AstraQ* x = hq + top*36;
+    float v = astra_dot32(r,lane,x[lane]);
+    if (lane<4) v += astra_dot32(r,32+lane,x[32+lane]);
+    v += astra_dot32(r,lane+16,x[lane+16]);
+    #pragma unroll
+    for (int d=8; d; d>>=1) v += __shfl_xor_sync(0xffffffffu,v,d,16);
+    if (lane==0) parts[top*2304+row] = v * ((const float*)(blob+L.tail_off))[2];
+}
