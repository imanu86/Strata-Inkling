+#pragma once
+
+namespace strata::inkling2 {
+
+struct AttentionPrepT1 {
+    float *q, *r;
+    const float *k, *v, *q_scale, *r_scale, *k_weight, *v_weight, *k_dynamic, *v_dynamic;
+    float *hist;
+    int8_t *kq, *vq;
+    __half *ks, *vs;
+    const float *rel_bias, *sink;
+    float *rel_table;
+    const int32_t *pos;
+    int heads, kv_heads, cap, swa, floor_n, n_ext, max_rel;
+    float q_clip, r_clip, alpha, eps;
+};
+
+// Each lane owns the same components, and reduces its sum in the same order,
+// as k_clip_and_tau. R is also passed to the relative table through shared memory.
+template<int D>
+__device__ __forceinline__ void prep_clip_t1(float* x, const float* scale, float threshold, int head,
+                                             int pos, const AttentionPrepT1& a, float* shared_values) {
+    constexpr int Count = (D + 31) / 32;
+    int lane = threadIdx.x & 31;
+    int base = D * head;
+    float vals[Count], sq = 0.0f;
+#pragma unroll
+    for (int i = 0; i < Count; ++i) {
+        int c = 32 * i + lane;
+        float v = c < D ? x[base + c] : 0.0f;
+        if (c < D && scale) v *= scale[base + c];
+        vals[i] = v;
+        sq += v * v;
+    }
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) sq += __shfl_xor_sync(0xffffffffu, sq, off);
+    float factor = fminf(1.0f, threshold / (sqrtf(sq) + 1e-6f));
+    if (!a.swa) {
+        float ratio = fmaxf(1.0f, (float)(pos + 1) / (float)a.floor_n);
+        factor *= (1.0f + a.alpha * logf(ratio));
+    }
+#pragma unroll
+    for (int i = 0; i < Count; ++i) {
+        int c = 32 * i + lane;
+        if (c < D) {
+            float result = vals[i] * factor;
+            x[base + c] = result;
+            if (shared_values) shared_values[c] = result;
+        }
+    }
+}
+
+__device__ __forceinline__ void prep_kv_t1(const AttentionPrepT1& a, int head, bool value, int pos, float* shared) {
+    int channel = head * 128 + threadIdx.x;
+    int kv_dim = 128 * a.kv_heads;
+    float* hist = a.hist + (size_t)(channel + (value ? kv_dim : 0)) * 3;
+    float h0 = hist[0], h1 = hist[1], h2 = hist[2];
+    const float4 w = ((const float4*)(value ? a.v_weight : a.k_weight))[channel];
+    const float* dyn = value ? a.v_dynamic : a.k_dynamic;
+    const float x = (value ? a.v : a.k)[channel];
+    float s = h0 * w.x + h1 * w.y + h2 * w.z + x * w.w;
+    if (dyn) {
+        const float* dt = dyn + head * 4;
+        s += x * dt[0] + h2 * dt[1] + h1 * dt[2] + h0 * dt[3];
+    }
+    shared[threadIdx.x] = (x + s) * rsqrtf(dyn ? 9.0f : 5.0f);
+    hist[0] = h1;
+    hist[1] = h2;
+    hist[2] = x;
+    __syncthreads();
+
+    if (threadIdx.x >= 32) return;
+    int lane = threadIdx.x;
+    float v[4], sq = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        v[i] = shared[i * 32 + lane];
+        sq += v[i] * v[i];
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) sq += __shfl_xor_sync(0xffffffffu, sq, o);
+    float factor = value ? rsqrtf(sq / 128.0f + a.eps) : fminf(1.0f, a.q_clip / (sqrtf(sq) + 1e-6f));
+    float peak = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        v[i] *= factor;
+        peak = fmaxf(peak, fabsf(v[i]));
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) peak = fmaxf(peak, __shfl_xor_sync(0xffffffffu, peak, o));
+    float inv = peak > 0.0f ? (127.0f / peak) : 0.0f;
+    int slot = a.swa ? (((a.cap & (a.cap - 1)) == 0) ? pos & (a.cap - 1) : pos % a.cap) : pos;
+    int8_t* dst = (value ? a.vq : a.kq) + ((size_t)slot * a.kv_heads + head) * 128;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) dst[i * 32 + lane] = (int8_t)__float2int_rn(v[i] * inv);
+    if (!lane) (value ? a.vs : a.ks)[(size_t)slot * a.kv_heads + head] = __float2half(peak / 127.0f);
+}
+
+// Grid is constant across CUDA graph replays. Each CTA has independent output.
+__global__ __launch_bounds__(128) void k_attention_prep_t1(AttentionPrepT1 a) {
+    __shared__ __align__(16) float buf[128];
+    int h = blockIdx.x, pos = *a.pos;
+    if (h >= a.heads) {
+        int kv = h - a.heads;
+        bool value = kv >= a.kv_heads;
+        prep_kv_t1(a, value ? kv - a.kv_heads : kv, value, pos, buf);
+        return;
+    }
+    if (threadIdx.x < 32) prep_clip_t1<128>(a.q, a.q_scale, a.q_clip, h, pos, a, nullptr);
+    if (threadIdx.x >= 32 && threadIdx.x < 64) prep_clip_t1<16>(a.r, a.r_scale, a.r_clip, h, pos, a, buf);
+    __syncthreads();
+    const float4* sr = (const float4*)buf;
+    const float4 sr0 = sr[0], sr1 = sr[1], sr2 = sr[2], sr3 = sr[3];
+    float sk = a.sink[h];
+    int max_d = min(min(a.n_ext, a.max_rel), pos + 1);
+    for (int d = threadIdx.x; d < max_d; d += blockDim.x) {
+        const float4* rb = (const float4*)(a.rel_bias + (size_t)d * 16);
+        const float4 r0 = rb[0], r1 = rb[1], r2 = rb[2], r3 = rb[3];
+        const float dot = (sr0.x * r0.x + sr0.y * r0.y + sr0.z * r0.z + sr0.w * r0.w)
+                        + (sr1.x * r1.x + sr1.y * r1.y + sr1.z * r1.z + sr1.w * r1.w)
+                        + (sr2.x * r2.x + sr2.y * r2.y + sr2.z * r2.z + sr2.w * r2.w)
+                        + (sr3.x * r3.x + sr3.y * r3.y + sr3.z * r3.z + sr3.w * r3.w);
+        a.rel_table[(size_t)h * a.n_ext + d] = dot - sk;
+    }
+}
+
+} // namespace strata::inkling2
