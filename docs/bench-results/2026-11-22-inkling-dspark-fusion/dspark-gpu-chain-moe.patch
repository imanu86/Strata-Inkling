+    e.reset_state();
+    for(size_t off=0;off<prompt.size();off+=(size_t)chunk) {
+        const int n=(int)std::min<size_t>(chunk,prompt.size()-off);
+        e.forward(prompt.data()+off,n,false,nullptr,false,true);
+    }
+    ReplaySnapshot local(e),remote(*e.split_peer);
+    auto state=[&](bool restore){local.transfer(restore);remote.transfer(restore);};
+    auto sync=[&](){
+        {DeviceScope own(e.device);CK(cudaStreamSynchronize(e.st));}
+        {DeviceScope own(e.split_peer->device);CK(cudaStreamSynchronize(e.split_peer->st));}
+    };
+    struct Window {int pos,count;std::vector<int32_t> ids;};
+    std::vector<Window> windows;
+    for(std::string line;std::getline(file,line);) {
+        std::istringstream fields(line); Window w{};int id;
+        if(!(fields>>w.pos>>w.count)||w.count<0||w.count>4)return 13;
+        for(int col=0;col<10;++col){if(!(fields>>id))return 14;if(col<5)w.ids.push_back(id);}
+        if(fields>>id)return 15;
+        windows.push_back(w);
+    }
+    if(windows.size()<25)return 16;
+    const int count=std::min(40,(int)windows.size()-1);
+    for(int i=0;i<count;++i){
+        const auto& w=windows[i]; const int next=windows[i+1].ids.front();
+        if(e.pos!=w.pos || windows[i+1].pos!=w.pos+1+w.count)return 17;
+        state(false);
+        std::vector<int32_t> singles;
+        for(int32_t id:w.ids) singles.push_back(e.forward(&id,1,false,nullptr,false,true));
+        // Every reference row sees the same proposals, even beyond the first rejection.
+        state(true);
+        int reference_next=-1;
+        if(w.count<4){
+            for(int j=0;j<=w.count;++j)e.forward(&w.ids[j],1,false,nullptr,false,true);
+            reference_next=e.forward(&next,1,false,nullptr,false,true);
+        }
+        for(int rep=0;rep<3;++rep){
+            state(true);
+            std::vector<int32_t> block;
+            auto start=Clock::now();
+            e.forward(w.ids.data(),5,false,nullptr,false,true,4,&block);
+            sync();
+            double verify=ms_since(start);
+            start=Clock::now();
+            e.commit_verify(w.count,4,w.pos);
+            sync();
+            double commit=ms_since(start);
+            if(block.size()!=5)return 18;
+            // A sixth token can overwrite a sixth SWA ring cell. It is not part of
+            // the five-slot snapshot, so probe after a rejection only.
+            int probe=-1;
+            if(w.count<4)probe=e.forward(&next,1,false,nullptr,false,true);
+            out<<i<<'\t'<<w.pos<<'\t'<<w.count<<'\t'<<rep<<'\t'<<verify<<'\t'<<commit<<'\t';
+            for(int j=0;j<5;++j)out<<(j?",":"")<<block[j];
+            out<<'\t';for(int j=0;j<5;++j)out<<(j?",":"")<<singles[j];
+            out<<'\t'<<probe<<'\t'<<(w.count<4?reference_next:-1)<<'\n';
+        }
+        state(true);
+        for(int j=0;j<=w.count;++j)e.forward(&w.ids[j],1,false,nullptr,false,true);
+    }
+    out.flush();return out?0:19;
+}
