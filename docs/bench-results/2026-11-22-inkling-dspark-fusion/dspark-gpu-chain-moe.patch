+#pragma once
+struct VFConvRows { float* ptr[48]; int slot[48]; int n=0; };
+__global__ void vf_restore(VFConvRows p,const float* trace,size_t total,size_t width,int index){
+    const int l=blockIdx.y;const size_t i=(size_t)blockIdx.x*blockDim.x+threadIdx.x;
+    if(l<p.n && i<width)p.ptr[l][i]=trace[(size_t)index*total+(size_t)p.slot[l]*width+i];
+}
+// Same winner as the legacy kernel, including tied maxima and ignored NaNs.
+struct VFWinner {float v;int id;};
+__device__ inline VFWinner vf_best(VFWinner a,VFWinner b) {
+    return b.v>a.v || (a.v==b.v && b.id<a.id) ? b : a;
+}
+__device__ inline VFWinner vf_warp(VFWinner x){
+    for(int d=16;d;d/=2){VFWinner b{__shfl_down_sync(~0u,x.v,d),__shfl_down_sync(~0u,x.id,d)};x=vf_best(x,b);}
+    return x;
+}
+template<bool Final>
+__global__ void vf_reduce(const float* logits,VFWinner* tiles,int* picks,int V,int ntiles){
+    __shared__ VFWinner warp[8];
+    int lane=threadIdx.x%32, w=threadIdx.x/32, row=blockIdx.y;
+    VFWinner x{-1.e30f,0};
+    if constexpr(Final){
+        for(int j=threadIdx.x;j<ntiles;j+=blockDim.x)x=vf_best(x,tiles[(size_t)row*ntiles+j]);
+    }else{
+        for(int j=blockIdx.x*blockDim.x+threadIdx.x;j<V;j+=gridDim.x*blockDim.x)
+            x=vf_best(x,{logits[(size_t)row*V+j],j});
+    }
+    x=vf_warp(x);if(!lane)warp[w]=x;__syncthreads();
+    if(w==0){x=lane<8?warp[lane]:VFWinner{-1.e30f,0};x=vf_warp(x);
+        if(lane==0){if constexpr(Final)picks[row]=x.id;else tiles[(size_t)row*ntiles+blockIdx.x]=x;}}
+}
+static void vf_argmax(const float* logits,VFWinner* tiles,int* picks,int V,int rows,cudaStream_t st) {
+    constexpr int tiles_per_row=64;
+    vf_reduce<false><<<dim3(tiles_per_row,rows),256,0,st>>>(logits,tiles,picks,V,tiles_per_row);
+    vf_reduce<true><<<dim3(1,rows),256,0,st>>>(logits,tiles,picks,V,tiles_per_row);
