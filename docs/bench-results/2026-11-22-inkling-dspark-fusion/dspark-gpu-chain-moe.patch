+static bool astra_verify_gu_enabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("STRATA_IK2_VERIFY_FUSED_GU");
+        return v && std::strcmp(v, "1") == 0;
+    }();
+    return enabled;
+}
+
+// One CTA computes all 32 hidden values that share a Q8 scale. The eight
+// warps each own four distinct rows, with native's 32-lane FP32 tree. At
+// T<=5 a direct top-k entry has its own output slot and needs no grouping.
+__global__ void __launch_bounds__(256) astra_verify_gu_situ_q8(
+    const uint8_t* blobs, size_t stride, const int* slots, const int* ids,
+    K::NativeExpertLayout L, const AstraQ* input, AstraQ* hidden) {
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int entry = blockIdx.y, first = blockIdx.x * 32;
+    const uint8_t* blob = blobs + stride * slots[ids[entry]];
+    const float* scale = (const float*)(blob + L.tail_off);
+    __shared__ AstraQ x[72];
+    __shared__ float2 products[32];
+    const AstraQ* token = input + (entry / 8) * 72;
+    // No type aliasing or layout conversion: each lane copies q8 fields.
+    for (int b = warp; b < 72; b += 8) {
+        if (lane < 8) x[b].word[lane] = token[b].word[lane];
+        if (lane == 8) x[b].scale = token[b].scale;
+    }
+    __syncthreads();
+#pragma unroll 1
+    for (int sub = warp; sub < 32; sub += 8) {
+        const int r = first + sub;
+        const unsigned* g = (const unsigned*)(blob + r * L.gu_row);
+        const unsigned* u = (const unsigned*)(blob + L.up_off + r * L.gu_row);
+        float vg = 0.0f, vu = 0.0f;
+#pragma unroll
+        for (int base = 0; base < 72; base += 32) {
+            const int k = base + lane;
+            if (k < 72) {
+                const AstraQ a = x[k];
+                vg += astra_dot32(g, k, a);
+                vu += astra_dot32(u, k, a);
+            }
+        }
+#pragma unroll
+        for (int offset = 16; offset; offset >>= 1) {
+            vg += __shfl_xor_sync(0xffffffffu, vg, offset);
+            vu += __shfl_xor_sync(0xffffffffu, vu, offset);
+        }
+        if (lane == 0) products[sub] = make_float2(vg * scale[0], vu * scale[1]);
+    }
+    __syncthreads();
+    if (warp == 0) {
+        const float2 gu = products[lane];
+        const float beta = L.situ_beta, lb = L.situ_linear_beta;
+        const float tg = beta * tanhf(gu.x / beta) * (1.0f / (1.0f + __expf(-gu.x)));
+        const float tu = lb > 0.0f ? lb * tanhf(gu.y / lb) : gu.y;
+        astra_store_q(tg * tu, hidden, entry * 1152 + first + lane);
+    }
+}
