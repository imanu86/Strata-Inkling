diff --git a/engine/src/inkling2/astra_verify_bf16.cuh b/engine/src/inkling2/astra_verify_bf16.cuh
new file mode 100644
--- /dev/null
+++ b/engine/src/inkling2/astra_verify_bf16.cuh
@@ -0,0 +1,33 @@
+#pragma once
+
+// A tiny Turing GEMM can have a single cuBLAS CTA for the entire matrix.
+// Each CTA here gathers the two operands for one independent result. The
+// accumulator then visits K in order to avoid an extra parallel sum tree.
+__global__ void __launch_bounds__(128) astra_verify_bf16_thin(
+    const float* __restrict__ x, const uint16_t* __restrict__ w,
+    float* __restrict__ y, int rows) {
+    constexpr int width = 2304;
+    __shared__ float2 terms[width];
+    const int token = blockIdx.y, row = blockIdx.x;
+    const float* input = x + token * width;
+    const uint16_t* weight = w + row * width;
+    for (int k = threadIdx.x; k < width; k += blockDim.x) {
+        const unsigned bits = __float_as_uint(input[k]);
+        const unsigned rounded = (bits + 0x7fffu + ((bits >> 16) & 1)) & 0xffff0000u;
+        terms[k] = make_float2(__uint_as_float(rounded),
+                               __uint_as_float((unsigned)weight[k] << 16));
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float acc = 0;
+#pragma unroll 1
+        for (int base = 0; base < width; base += 32) {
+#pragma unroll
+            for (int j = 0; j < 32; ++j) {
+                const float2 p = terms[base + j];
+                acc = __fmaf_rn(p.x, p.y, acc);
+            }
+        }
+        y[token * rows + row] = acc;
+    }
+}
