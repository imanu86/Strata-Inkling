+#pragma once
+
+// Q8_0 uses 17 halfwords per 32 weights: scale, then 16 words of nibbles/bytes.
+// Eight adjacent blocks occupy exactly 272 bytes in either representation.
+// Transpose within a CTA's disjoint tiles, in place, retaining all weight bits.
+template<bool Pack>
+__global__ void ik2_dense_layout(uint16_t* matrix, int groups) {
+    constexpr int per_cta=8, words=8*17;
+    __shared__ uint16_t tile[per_cta*words];
+    const int first=blockIdx.x*per_cta;
+    const int count=min(per_cta,groups-first)*words;
+    matrix+=(size_t)first*words;
+    for(int i=threadIdx.x;i<count;i+=blockDim.x) tile[i]=matrix[i];
+    __syncthreads();
+    for(int i=threadIdx.x;i<count;i+=blockDim.x) {
+        const int group=i/words, word=i%words, block=word/17, field=word%17;
+        const int transformed=group*words+(field==0 ? 128+block : 16*block+field-1);
+        if constexpr(Pack) matrix[transformed]=tile[i];
+        else matrix[i]=tile[transformed];
+    }
+}
+
+struct Ik2DenseQ81 { __half2 ds; int qs[8]; };
+static_assert(sizeof(Ik2DenseQ81)==36);
+
+// The 4 partials of the existing four-warp block are produced in precisely the
+// same K order by one warp. This is the row decomposition in q36_kernels.cuh.
+// The stable shape allows all 72/96 Q8 blocks of a row to be unrolled.
+template<int Blocks,bool Packed>
+__global__ void ik2_dense_rows(const uint16_t* __restrict__ weights,const Ik2DenseQ81* __restrict__ x,
+                               float* __restrict__ y,int rows) {
+    const int row=blockIdx.x*(blockDim.x/32)+(threadIdx.x>>5);
+    if(row>=rows)return;
+    const int lane=threadIdx.x&31;
+    const int pair=2*(lane&3);
+    const uint16_t* w=weights+(size_t)row*Blocks*17;
+    float partial[4]={};
+#pragma unroll
+    for(int p=0;p<4;++p) {
+#pragma unroll
+        for(int j=0;j<(Blocks+31)/32;++j) {
+            const int kb=(lane>>2)+8*p+32*j;
+            if(kb>=Blocks)continue;
+            unsigned short scale; int a,b;
+            if constexpr(Packed) {
+                const uint16_t* group=w+(kb>>3)*136;
+                scale=group[128+(kb&7)];
+                const int* q=reinterpret_cast<const int*>(group)+(kb&7)*8+pair;
+                a=q[0];b=q[1];
+            } else {
+                const uint16_t* block=w+kb*17;scale=block[0];
+                const uint16_t* q=block+1+pair*2;
+                a=(int)((unsigned)q[0]|((unsigned)q[1]<<16));
+                b=(int)((unsigned)q[2]|((unsigned)q[3]<<16));
+            }
+            int dot=__dp4a(a,x[kb].qs[pair],0);
+            dot=__dp4a(b,x[kb].qs[pair+1],dot);
+            const float d=__half2float(__ushort_as_half(scale))*__low2float(x[kb].ds);
+            partial[p]=fmaf(d,(float)dot,partial[p]);
+        }
+    }
+    float value=partial[0]+partial[1];value+=partial[2];value+=partial[3];
+#pragma unroll
+    for(int delta=16;delta;delta>>=1)value+=__shfl_xor_sync(0xffffffff,value,delta);
+    if(lane==0)y[row]=value;
+}
+
+template<bool Packed>
+static void ik2_dense_rows_launch(const void* weights,const void* x,float* y,int in,int out,cudaStream_t st) {
+    const int grid=(out+7)/8;
+    if(in==2304) ik2_dense_rows<72,Packed><<<grid,256,0,st>>>((const uint16_t*)weights,(const Ik2DenseQ81*)x,y,out);
+    else ik2_dense_rows<96,Packed><<<grid,256,0,st>>>((const uint16_t*)weights,(const Ik2DenseQ81*)x,y,out);
+}
