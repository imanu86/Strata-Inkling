@@ -0,0 +1,56 @@
+#pragma once
+
+// Members of Engine. A weight is immutable for this engine's lifetime.
+// Keep quantized weights available for the T<=8 native kernels.
+struct PrefillHalfWeight {
+    int type = -1;
+    int64_t rows = 0, cols = 0;
+    uint16_t* data = nullptr;
+};
+std::map<const void*, PrefillHalfWeight> pp_half_weights;
+bool pp_half_on = false, pp_half_sized = false;
+size_t pp_half_limit = 0, pp_half_bytes = 0;
+uint64_t pp_half_hits = 0, pp_half_misses = 0;
+
+bool project_cached_half(const DenseMat& w, float* y, int t, int64_t n, int64_t k) {
+    if (k <= 0 || n <= 0 || k > gemm->scratch_elems()) return false;
+    auto [it, fresh] = pp_half_weights.try_emplace(w.d);
+    auto& entry = it->second;
+    if (fresh) {
+        entry.type = w.type; entry.rows = n; entry.cols = k;
+        // Expert placement has already completed. Leave headroom for decode graphs.
+        if (!pp_half_sized) {
+            constexpr size_t reserve = 416ull << 20, limit = 1536ull << 20;
+            size_t available = 0, total = 0;
+            CK(cudaMemGetInfo(&available, &total));
+            pp_half_limit = available > reserve ? std::min(available - reserve, limit) : 0;
+            pp_half_sized = true;
+        }
+        const size_t bytes = (size_t)n * k * sizeof(uint16_t);
+        if (bytes <= pp_half_limit - pp_half_bytes) {
+            const cudaError_t status = cudaMalloc(&entry.data, bytes);
+            if (status == cudaSuccess) {
+                pp_half_bytes += bytes;
+                K::dequant_f16(w.type, w.d, 0, n, k, entry.data, st);
+            } else if (status == cudaErrorMemoryAllocation) {
+                (void)cudaGetLastError();
+                pp_half_limit = pp_half_bytes;
+            } else {
+                CK(status);
+            }
+        }
+    }
+    if (!entry.data || entry.type != w.type || entry.rows != n || entry.cols != k) {
+        ++pp_half_misses;
+        return false;
+    }
+    if (!fresh) ++pp_half_hits;
+    // Gemm::native splits large matrices at these exact output rows. Matching
+    // the same GEMM shapes and leading dimension retains its choice of algorithm.
+    const int64_t per_slice = gemm->scratch_elems() / k;
+    for (int64_t row = 0; row < n; row += per_slice) {
+        const int64_t count = std::min(n - row, per_slice);
+        gemm->f16(act_bf16, entry.data + row*k, y + row, t, count, k, n);
+    }
+    return true;
+}
